---
import { getCollection } from "astro:content";
import ShellLayout from "../layouts/ShellLayout.astro";
import ScaffoldBanner from "../components/ScaffoldBanner.astro";
import Editor from "@mondrian/editor/Editor.svelte";
import { swatchCssVars } from "../lib/work-plan";
import type { WorkDoc } from "../lib/work-plan";
import { withBase } from "../lib/url";

const base = import.meta.env.BASE_URL;
const entry = (await getCollection("works")).find(
  (item) => item.data.id === "kunsthaus-1930-rbby",
);
if (!entry) throw new Error("The kiosk's default work is missing from the catalog");
const work = entry.data as WorkDoc;
const catalogUrl = withBase(`/patterns/${work.id}.json`, base);
---
<ShellLayout title="Kiosk — Neoplastix" current="kiosk">
  <ScaffoldBanner seat={6} handle="galarp2005" title="M6 / M7 scaffold" />
  <article class="prose">
    <h1>Kiosk</h1>
    <p class="lede">
      First kiosk study: the same Svelte editor used on the create page.
      Offline cache, wake lock and idle reset belong to Seat 7 (M7).
    </p>
    <p class="btn-row">
      <a class="btn btn--primary" href={withBase(`/create/${work.id}/`, base)}>
        Open create
      </a>
      <a class="btn btn--ghost" href={withBase("/assignments/seat-6/", base)}>Seat 6 brief</a>
      <a class="btn btn--ghost" href={withBase("/assignments/seat-7/", base)}>Seat 7 brief</a>
    </p>
  </article>
  <div style={swatchCssVars(work)}>
    <Editor work={work} catalogUrl={catalogUrl} client:load />
  </div>
</ShellLayout>
