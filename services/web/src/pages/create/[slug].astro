---
import { getCollection } from "astro:content";
import ShellLayout from "../../layouts/ShellLayout.astro";
import Editor from "@mondrian/editor/Editor.svelte";
import { swatchCssVars } from "../../lib/work-plan";
import { withBase } from "../../lib/url";
import type { WorkDoc } from "../../lib/work-plan";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((entry: { data: WorkDoc }) => ({
    params: { slug: entry.data.id },
    props: { work: entry.data as WorkDoc },
  }));
}

interface Props {
  work: WorkDoc;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL;
const q = Astro.url.search;
const galleryHref = `${withBase(`/gallery/${work.id}/`, base)}${q}`;
---
<ShellLayout title={`Create ${work.title} — Neoplastix`} current="create" noindex>
  <div class="editor-page" style={swatchCssVars(work)}>
    <Editor work={work} galleryHref={galleryHref} galleryIndexHref={withBase("/gallery/", base)} client:load />
  </div>
</ShellLayout>

<script>
  // Statically generated routes need the browser query string for recipe links.
  const studyLink = document.querySelector<HTMLAnchorElement>("[data-recipe-gallery-link]");
  if (studyLink) {
    const studyUrl = new URL(studyLink.href);
    studyUrl.search = window.location.search;
    studyLink.href = studyUrl.href;
  }
</script>

<style is:global>
  /* Limit viewport sizing to the Create route; other pages keep their existing shell. */
  @media (min-width: 52rem) and (min-height: 35rem) {
    body:has(.editor-page) {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      height: 100dvh;
    }
    body:has(.editor-page) > .shell-header,
    body:has(.editor-page) > .shell-footer,
    body:has(.editor-page) > .shell-main {
      box-sizing: border-box;
      width: 100%;
    }
    body:has(.editor-page) > .shell-main {
      display: grid;
      min-height: 0;
      padding-block: var(--nx-space-2);
    }
    body:has(.editor-page) > .shell-footer { padding-block: var(--nx-space-1); }
    .editor-page { min-height: 0; }
    .editor-page > astro-island { display: block; height: 100%; min-height: 0; }
  }
</style>
